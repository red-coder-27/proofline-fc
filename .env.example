# ==============================================================================
# Proofline FC - Microsoft Foundry / Azure OpenAI Configuration
# ==============================================================================
# Copy this file to .env.local to configure your live Azure AI Foundry credentials.
# IMPORTANT: .env.local is gitignored. Do NOT commit live keys to source control.
# Server-side variables: Do NOT prefix with NEXT_PUBLIC_ to keep keys secure.

# Azure AI Foundry Endpoint or Azure OpenAI Endpoint
# Supported formats:
# 1. Base URL: https://<your-resource-name>.openai.azure.com
# 2. Azure AI Foundry Project URL: https://<your-project>.services.ai.azure.com
# 3. Full completions URL: https://<your-resource>.openai.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2024-08-01-preview
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.openai.azure.com

# Azure AI Foundry or Azure OpenAI API Key
AZURE_AI_FOUNDRY_KEY=your_azure_foundry_api_key_here

# Model Deployment Name (default: gpt-4o)
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4o

# Azure OpenAI REST API Version (default: 2024-08-01-preview)
AZURE_OPENAI_API_VERSION=2024-08-01-preview
